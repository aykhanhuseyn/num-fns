{
  "name": "num-fns",
  "version": "0.1.0",
  "description": "Modern internationalized number utility library for JavaScript — format and parse numbers, money and percentages, spell numbers out in words, ordinals, short/long notation and roman numerals. Like date-fns, but for numbers.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./locale": {
      "types": "./dist/locale/index.d.ts",
      "import": "./dist/locale/index.js",
      "require": "./dist/locale/index.cjs"
    },
    "./locale/az": {
      "types": "./dist/locale/az.d.ts",
      "import": "./dist/locale/az.js",
      "require": "./dist/locale/az.cjs"
    },
    "./locale/en": {
      "types": "./dist/locale/en.d.ts",
      "import": "./dist/locale/en.js",
      "require": "./dist/locale/en.cjs"
    },
    "./locale/ru": {
      "types": "./dist/locale/ru.d.ts",
      "import": "./dist/locale/ru.js",
      "require": "./dist/locale/ru.cjs"
    },
    "./locale/es": {
      "types": "./dist/locale/es.d.ts",
      "import": "./dist/locale/es.js",
      "require": "./dist/locale/es.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=14"
  },
  "packageManager": "bun@1.3.14",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aykhanhuseyn/num-fns.git"
  },
  "bugs": {
    "url": "https://github.com/aykhanhuseyn/num-fns/issues"
  },
  "homepage": "https://github.com/aykhanhuseyn/num-fns#readme",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "site:dev": "vite dev --config site/vite.config.ts",
    "site:build": "vite build --config site/vite.config.ts",
    "site:preview": "vite preview --config site/vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check:biome": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true",
    "check:type": "tsc --version && tsc --noEmit --incremental -p tsconfig.json",
    "check:circular": "dpdm --no-warning --no-tree --exit-code circular:1 --extensions .ts src/index.ts",
    "check:unused": "knip --cache --no-exit-code",
    "check": "bun run check:type && bun run check:circular && bun run check:unused && bun run check:biome --",
    "prepare": "lefthook install",
    "prepublishOnly": "bun run check && bun run test && bun run build"
  },
  "keywords": [
    "number",
    "numbers",
    "i18n",
    "internationalization",
    "l10n",
    "localization",
    "locale",
    "money",
    "currency",
    "percentage",
    "number-to-words",
    "spell-number",
    "ordinal",
    "roman-numerals",
    "notation",
    "formatting",
    "parsing",
    "typescript",
    "az",
    "en",
    "ru",
    "es"
  ],
  "author": "Aykhan Huseynli <aykhanrh@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@types/bun": "1.3.14",
    "@typescript/typescript6": "6.0.2",
    "dpdm": "4.3.0",
    "knip": "6.32.0",
    "lefthook": "2.1.10",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vite-plugin-dts": "5.0.3"
  }
}
