{
  "name": "num-fns",
  "version": "0.1.0",
  "description": "Modern internationalized number utility library for JavaScript — format and parse numbers, money and percentages, spell numbers out in words, ordinals, short/long notation and roman numerals. Like date-fns, but for numbers.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=14"
  },
  "packageManager": "bun@1.3.14",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aykhanhuseyn/num-fns.git"
  },
  "bugs": {
    "url": "https://github.com/aykhanhuseyn/num-fns/issues"
  },
  "homepage": "https://github.com/aykhanhuseyn/num-fns#readme",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "prepublishOnly": "bun run typecheck && bun run lint && bun run test && bun run build"
  },
  "keywords": [
    "number",
    "numbers",
    "i18n",
    "internationalization",
    "l10n",
    "localization",
    "locale",
    "money",
    "currency",
    "percentage",
    "number-to-words",
    "spell-number",
    "ordinal",
    "roman-numerals",
    "notation",
    "formatting",
    "parsing",
    "typescript",
    "az",
    "en",
    "ru",
    "es"
  ],
  "author": "Aykhan Huseynli <aykhanrh@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/bun": "1.3.14",
    "@typescript/typescript6": "6.0.2",
    "ajv": "8.20.0",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vite-plugin-dts": "5.0.3"
  }
}
