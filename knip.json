{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/index.ts",
    "src/locale/index.ts",
    "src/locale/az.ts",
    "src/locale/en.ts",
    "src/locale/en-gb.ts",
    "src/locale/ru.ts",
    "src/locale/es.ts",
    "scripts/*.ts",
    "bench/*.bench.ts",
    "site/src/pages/*/main.tsx",
    "site/src/review/main.tsx"
  ],
  "project": [
    "src/**/*.ts",
    "site/src/**/*.{ts,tsx}",
    "scripts/**/*.ts",
    "bench/**/*.ts",
    "!scripts/smoke/**"
  ],
  "ignoreDependencies": ["@typescript/typescript6", "@typescript/old"]
}
