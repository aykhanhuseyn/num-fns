{
  "compilerOptions": {
    "target": "ES2018",
    "lib": ["ES2020"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "types": ["bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "declaration": false,
    "noEmit": true
  },
  "include": ["src", "scripts"],
  // The smoke fixtures under `scripts/smoke/` are consumer projects, not part
  // of this one: they import `num-fns` from their own `node_modules` (see
  // `scripts/smoke.mjs`) and carry their own tsconfig, so typechecking them
  // from here would fail on an unresolvable module.
  "exclude": ["scripts/smoke"]
}
